# ------------------------------------------------------------------
# HUB-042 – Vorlage für .env (die echte .env ist gitignored!)
# ------------------------------------------------------------------

# Pflicht-Statuszeile (Übung 1): "Hallo von [APP_NAME] – Besucher Nr. … – DB: verbunden – Version: …"
APP_NAME=Alban
PORT=3000
# Öffentliche Adresse für Links in E-Mails. Leer lassen = aus der Anfrage ableiten (Quick Tunnel ändert die URL bei jedem Neustart)
PUBLIC_URL=

# Datenbank (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=webapp_db
DB_USER=webapp_user
DB_PASSWORD=change_me_db_password
# Name des Docker-Volumes der Datenbank (bestehende Installation: modul042-webapp_postgres_data)
DB_VOLUME=modul042-webapp_postgres_data

# Signierte Session-Cookies (langer Zufallswert, z. B. `openssl rand -hex 32`)
SESSION_SECRET=change_me_long_random_session_secret
# Werkspasswort für Passwort-Resets durch den Admin (8–20 Zeichen, NUR hier, nie ins Repo)
# Nach einem Reset braucht es beim Login zusätzlich die persönliche Wiederherstellungs-ID
RESET_PASSWORD=change_me_werkspasswort

# true, sobald die App nur noch über HTTPS erreichbar ist
COOKIE_SECURE=false

# ------------------------------------------------------------------
# Zugang: nur diese Adressen kommen rein (Teilnehmerliste)
# Die Liste gehört NICHT ins öffentliche Repo, nur in die .env.
# Weitere Personen lassen sich im HUB-042 unter "Verwaltung" ergänzen.
# ------------------------------------------------------------------
ADMIN_EMAILS=alban.hyseni@stud.hkv.ch
# Dozent Applications Engineering (vorname.nachname@hkv.ch)
DOZENT_EMAILS=vorname.nachname@hkv.ch
TEILNEHMER_EMAILS=vorname.nachname@stud.hkv.ch,vorname2.nachname2@stud.hkv.ch
ALLOWED_EMAIL_DOMAINS=stud.hkv.ch,hkv.ch

# ------------------------------------------------------------------
# Mailversand (Bestätigung, Einladungen, Willkommens-Mail, Passwort-Reset)
# Variante A: HKV-Schulkonto (Microsoft 365), nur wenn die Schule SMTP AUTH erlaubt
#   SMTP_HOST=smtp.office365.com / SMTP_PORT=587 / SMTP_USER=deine@stud.hkv.ch
# Variante B (zuverlässig): Gmail mit App-Passwort, Antworten gehen an die Schuladresse
#   SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USER=deine@gmail.com
#   SMTP_PASS=16-stelliges App-Passwort / MAIL_REPLY_TO=deine@stud.hkv.ch
# Ohne SMTP erscheinen die Links im Server-Log, Admins schalten Konten manuell frei.
# In der App: Verwaltung → "Test-Mail an mich senden"
# ------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=vorname.nachname@stud.hkv.ch
SMTP_PASS=dein_passwort_oder_app_passwort
MAIL_FROM=HUB-042 <vorname.nachname@stud.hkv.ch>
MAIL_REPLY_TO=

# ------------------------------------------------------------------
# Hilfe-Bot (optional): Google Gemini API-Key aus https://aistudio.google.com/apikey
# Leer lassen = der Bot antwortet aus der eingebauten FAQ
# ------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Git-Commit-Version (wird von CI/CD gesetzt)
APP_VERSION=local-preview
