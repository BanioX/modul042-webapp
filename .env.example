# Web Application Configuration
APP_NAME=Alban
PORT=3000
PUBLIC_URL=https://example.trycloudflare.com

# Database Configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=webapp_db
DB_USER=webapp_user
DB_PASSWORD=change_me_db_password

# Signed session cookies (httpOnly, sameSite=lax)
SESSION_SECRET=change_me_long_random_session_secret

# SMTP (Gmail App-Passwort oder anderer SMTP-Anbieter)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_address@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=ATL-Arena <your_address@gmail.com>

# Git Commit Version (injected by CI/CD or build)
APP_VERSION=local-preview
